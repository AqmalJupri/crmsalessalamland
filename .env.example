# Local development only. Never commit real credentials.
DATABASE_URL=postgres://crm:crm_local_only@127.0.0.1:5432/crm
APP_URL=http://localhost:3000
PRODUCT_SURFACE=crm
DEPLOYMENT_ENVIRONMENT=local
CRM_DEMO_MODE=true
SESSION_TTL_HOURS=12
DATABASE_POOL_MAX=10
AUTH_HASH_KEY=replace-with-at-least-32-random-characters

# Optional local authentication (managed OpenID Connect provider)
OIDC_ISSUER=https://identity.example.com/
OIDC_CLIENT_ID=crm-local
OIDC_CLIENT_SECRET=replace-from-secret-manager
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/oidc/callback

# Production must set CRM_DEMO_MODE=false and inject secrets from a secret manager.
